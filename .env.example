# Claude (used for the --claude frontier-LLM configuration)
ANTHROPIC_API_KEY=

# Gemini (used for the optional --gemini configuration)
GEMINI_API_KEY=

# Token needed to access gated models from HuggingFace. You can get one here: https://huggingface.co/settings/tokens
HF_TOKEN=

# Token needed to access models from TabPFN (used by the --tabpfn meta-learner base model). You can get one here: https://ux.priorlabs.ai/account/api-keys
TABPFN_TOKEN=
